# ================= DATABASE =================
DB_URL=jdbc:postgresql://db:5432/fish_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
POSTGRES_DB=fish_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password

# ================= REDIS =================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ================= JWT =================
JWT_SECRET=your_jwt_secret_key_base64_encoded

# ================= CLOUDINARY =================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================= VNPAY =================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8083/api/customer/checkout/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:3001/checkout/vnpay-return

# ================= GHN =================
GHN_TOKEN=your_ghn_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# ================= AI =================
OPENROUTER_API_KEY=your_openrouter_api_key

# ================= NEXT AUTH / GOOGLE =================
NEXTAUTH_SECRET=your_nextauth_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
